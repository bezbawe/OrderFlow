{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "OtlpEndpoint": "http://127.0.0.1:4317"
  },
  "ReverseProxy": {
    "Routes": {
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "orders-cluster": {
        "Destinations": {
          "orders": {
            "Address": "http://127.0.0.1:5275/"
          }
        }
      }
    }
  },
  "DownstreamServices": {
    "orders": "http://127.0.0.1:5275",
    "inventory": "http://127.0.0.1:5116",
    "notifications": "http://127.0.0.1:5247"
  }
}
